# ─────────────────────────────────────────────────────────────
# DATABASE — Postgres everywhere (Neon free tier)
#
# The app and local dev point at the SAME free database, using two branches:
#   -pooler hostname  -> the app / scrape runs   (connection pooling)
#   direct hostname   -> migrations and db push
#
# Format (from Neon dashboard -> Connection Details):
#   postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# only needed when you run `prisma db push` / `migrate deploy`:
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────────────────────
# AUTH  (generate with: openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-random-32-char-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# ADMIN  (comma separated usernames allowed to open /admin)
# ─────────────────────────────────────────────────────────────
ADMIN_USERS="ahmed"
ADMIN_PASSWORD="change-this-before-deploying"

# ─────────────────────────────────────────────────────────────
# SCRAPER
#
# The schedule lives in .github/workflows/scrape.yml, NOT here — a free
# Vercel cron can only fire once a day, which is far too coarse for a crawl.
# ─────────────────────────────────────────────────────────────
# providers to run: comma separated keys from src/lib/scraper/providers
SCRAPER_PROVIDERS="anilist,jikan"
# how many listing pages to crawl per provider run. Keep this modest: the
# workflow has a job timeout and AniList rate-limits aggressively.
SCRAPER_MAX_PAGES="3"
# set to "1" to skip writes and print what would be imported
SCRAPER_DRY_RUN="0"
# name the crawler uses when checking robots.txt. The origin matches this
# against its User-agent groups, so a specific name can get its own rules.
SCRAPER_USER_AGENT="WatchBoxBot"
# image proxy allowlist (comma separated). "*" allows any host.
IMAGE_PROXY_ALLOWLIST="*"
# image proxy cache lifetime in seconds
IMAGE_PROXY_TTL="86400"

# ─────────────────────────────────────────────────────────────
# SOURCE API KEYS  (all free, all optional)
# ─────────────────────────────────────────────────────────────
TMDB_API_KEY=""
TMDB_LANGUAGE="en-US"

# ─────────────────────────────────────────────────────────────
# OPTIONAL 3rd-PARTY SCRAPE SOURCES
# Each block describes one HTML site the generic scraper reads.
# See README "Adding a new source" for the full field list.
# Generate a first draft with:  npm run probe -- <listing-page-url>
# Check what an origin permits with: npm run robots -- <url>
# ─────────────────────────────────────────────────────────────
# SOURCES_JSON='[{"id":"example","name":"Example","baseUrl":"https://example.com","type":"movie","enabled":false}]'
