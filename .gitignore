# Any .env variant, including backups and rotated copies. `.env` alone is not
# enough: `secrets:rotate` writes .env.bak-* beside it, and a backup holding a
# superseded-but-still-valid secret is exactly the file that must not be pushed.
.env
.env*
!.env.example

.vercel
*.tsbuildinfo
next-env.d.ts

/prisma/*.db
/prisma/*.db-journal
/storage
